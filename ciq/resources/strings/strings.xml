<strings>
    <string id="AppName">TrainBud</string>
    <string id="ServerUrlTitle">Server URL</string>
    <string id="CardOverview">Overview</string>
    <string id="CardRecovery">Recovery</string>
    <string id="CardSleep">Sleep</string>
    <string id="CardActivity">Activity</string>
    <string id="CardStress">Stress</string>
    <string id="CardVo2Max">VO2 Max</string>
    <string id="CardAiInsight">AI Insight</string>
    <!-- Week card, added 1.4.0. Training is planned in weeks and every other
         screen in this app answers "how am I today". -->
    <string id="CardWeek">Week</string>
    <string id="WeekNeedTwo">needs 2 weeks</string>
    <string id="WeekSession">session</string>
    <string id="WeekSessions">sessions</string>
    <string id="WeekLoad">Load</string>
    <!-- The load forecast: where the acute:chronic ratio lands if next week
         repeats this one. Worded as what it is — an extrapolation of the last
         seven days, not a plan the user entered. -->
    <string id="WeekSpikeAhead">Spike ahead</string>
    <string id="WeekEasingOff">Easing off</string>
    <string id="WeekOnTrack">On track</string>
    <string id="WeekSleepDebt">Sleep debt</string>
    <!-- Sleep card footnote: last night against this person's own median night,
         and how much their nights vary. Duration alone cannot tell a late film
         from a fortnight of short nights, and regularity predicts how rested
         someone is beyond duration. -->
    <string id="SleepUsually">Usually</string>
    <string id="SleepSteady">steady</string>
    <string id="SleepVariable">variable</string>
    <string id="SleepErratic">erratic</string>
    <!-- Race countdown. The context store has held races since the memory layer
         landed and nothing ever read one for its date, though it changes what
         every other number on this watch means. -->
    <string id="RaceDays">days to</string>
    <string id="RaceToday">Race day</string>
    <string id="RaceTomorrow">Race tomorrow</string>
    <string id="CardAskAi">Ask AI</string>
    <string id="CardToday">Today</string>
    <!-- Shown until there is enough history to compare a day against a
         baseline. An empty findings list and an unknown answer must not look
         the same: without this the app tells a brand-new user that nothing
         stands out, which it cannot possibly know yet. -->
    <string id="TodayGathering">Still gathering</string>
    <string id="TodayGatheringDays">of 14 days</string>
    <string id="TodayNothing">Nothing stands out</string>
    <string id="TodayNothingHint">against your baselines</string>
    <string id="Loading">Loading...</string>
    <string id="NoData">No data</string>
    <!-- Compact placeholder for the four-cell overview grid, where "No data"
         is wide enough to overlap the neighbouring cell and its own label. -->
    <string id="NoDataShort">--</string>
    <string id="StalePrefix">Updated</string>
    <string id="StaleSuffix">ago</string>
    <string id="LabelRecovery">Rec</string>
    <string id="LabelSleep">Sleep</string>
    <string id="LabelStress">Stress</string>
    <string id="LabelVo2">VO2</string>
    <string id="LabelResting">Resting</string>
    <string id="LabelMax">Max</string>
    <!-- Compact form for the Recovery card on a small round screen, where
         "Resting 48  Max 178" does not fit and truncating it loses the
         maximum heart rate entirely. The number is worth more than the
         word. -->
    <string id="LabelRestingShort">Rest</string>

    <!-- First run, no server configured.

         This replaces a single line reading "Set Server URL in the Connect IQ
         app settings", which was almost never reached: the build shipped a
         default URL, so a fresh install skipped straight past this state and
         failed to pair against a dead host instead. Now that the default is
         empty this is what a new user actually sees first, so it has to say
         what TrainBud is and where the server comes from, not just name a
         settings field. -->
    <string id="SetupTitle">Setup required</string>
    <string id="SetupBody">TrainBud needs your own server. Set Server URL in the app settings.</string>
    <string id="SetupUrl">github.com/Zsadigzade/trainbud</string>

    <!-- Pairing failure, split by cause.

         There used to be exactly one message, "Pairing failed. Tap to retry.",
         for every outcome: no phone, wrong URL, a dead tunnel answering 404, a
         captive portal answering 200 with HTML, and a server that was up and
         refusing. Each needs a different action from the user, and the single
         message told them none of it. -->
    <string id="PairErrUnreachable">Cannot reach server</string>
    <string id="PairErrNotServer">Not a TrainBud server</string>
    <string id="PairErrRefused">Server refused pairing</string>
    <string id="HintNoPhone">Phone not connected</string>
    <string id="HintHttps">Use an https:// URL</string>
    <string id="HintBadCert">Certificate refused. Use a trusted one.</string>
    <string id="HintCheckUrl">Check the Server URL</string>
    <string id="HintTooMany">Too many tries. Wait a minute.</string>
    <!-- A 401 or 403 is a server that was reached, understood the request and
         declined this credential. Every one of these used to render as "cannot
         reach", which is the one thing that is certainly untrue when the server
         has answered. It happens whenever the API key is rotated: the watch
         keeps a key that no longer exists and pairing again is the whole fix. -->
    <string id="ErrUnauthorized">Watch not authorised</string>
    <string id="HintRepair">Pair this watch again</string>
    <!-- The raw Connect IQ code, always shown under the message. Negative codes
         are Connect IQ constants rather than HTTP statuses, and having the
         number on the watch face is what finally identified -200 and -400 in
         the 2026-08 pairing investigation. Keep it. -->
    <string id="ErrorCodePrefix">Error</string>

    <string id="PairingTitle">Pair Watch</string>
    <string id="PairingInstructions">Open dashboard &amp; enter code:</string>

    <string id="FetchError">Could not reach TrainBud</string>

    <!-- Action hints come in pairs, chosen at runtime from
         System.getDeviceSettings().isTouchScreen.

         Five products in the manifest have no touch screen at all: fr55 (the
         device this was reported from), fr745, and the three Instinct 3
         variants. Every hint in the app told those users to tap something.

         Carousel navigation has no hint of its own: the page dots show position,
         and UP/DOWN paging inside an app is a device-wide convention. A
         permanent line of instruction is not worth the room on a 208 px
         screen. -->
    <string id="RetryTouch">Tap to retry</string>
    <string id="RetryButton">START to retry</string>
    <string id="SelectTouch">Tap to select</string>
    <string id="SelectButton">START to select</string>

    <string id="AiThinking">Asking AI...</string>
    <string id="AiError">AI unavailable</string>
    <!-- The answer did not come back in time. It was a bare English literal in
         TrainBudApp.mc, the only user-visible string in the app that was not a
         resource, so it could never be translated. -->
    <string id="AiTimedOut">Answer took too long</string>
    <string id="AiNoInsight">No insight today</string>
    <!-- AI has never been set up on this server, which is a different thing
         from a call that failed and needs a different action from the user.
         The watch drew "AI unavailable" for both, and for a server that simply
         had not generated today's insight yet. On this install the only two
         prompts ever submitted failed with "ANTHROPIC_API_KEY not configured"
         and the watch never said so. -->
    <string id="AiNotSetUp">AI not set up</string>
    <string id="AiSetUpHint">Add an API key in the dashboard</string>
    <string id="AskPrompt1">Should I train today?</string>
    <string id="AskPrompt2">How is my recovery?</string>
    <string id="AskPrompt3">Optimize my sleep tonight</string>
    <string id="AskPrompt4">Summarize my week</string>
    <string id="AskPrompt5">Am I overtraining?</string>
    <string id="ResultPrefix">AI:</string>
    <!-- Shown on the last page of an AI answer. It existed as a string from
         1.2.0 and was never drawn anywhere, so the app made training and
         recovery statements on a health device with no disclaimer on screen at
         all. The store listing carried one; the watch did not. -->
    <string id="AiDisclaimer">Wellness info only. Not medical advice.</string>
    <string id="GlanceTitle">TrainBud</string>
    <string id="GlanceNoData">Open to sync</string>
</strings>
