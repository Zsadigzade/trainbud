project.manifest = manifest.xml

# Stated rather than left to the default.
#
# The default source path is wider than `source`, and adding a sibling
# `source-screens` directory for the debug screen tour silently pulled it into
# the STORE build as well -- which only surfaced as "Redefinition of isActive"
# because the tour and its shipping stub deliberately share a module name. Had
# they not collided, the store package would have quietly shipped the debug
# driver. Pin it, so a new directory is opt-in.
base.sourcePath = source

# The Forerunner 55 build leaves out the 2.1.0 finding detail, mute and sleep
# footnote. Its widget has 64 KB in total; 2.0.4 already used 55.5 of it with an
# ordinary payload, and those screens are about 7 KB of code, so the full build
# ran out of memory loading the cached summary. Every other product in the
# manifest has at least 128 KB.
#
# Each piece of that UI carries (:fullUi) and has a (:lowMem) stub beside it.
# Exactly one of the two must be excluded per device, or the build fails with a
# redefinition -- and a jungle setting is ASSIGNED, not appended, so every
# overlay that sets base.excludeAnnotations restates both lines.
# tests/watchLowMem.test.ts checks that they do.
base.excludeAnnotations = lowMem
fr55.excludeAnnotations = fullUi

# Fast optimizations. The SDK default is basic (level 1); level 2 makes the
# Forerunner 55 build 1.4 KB smaller (45.4 KB of code down to 44.1), which on a
# 64 KB widget is a quarter of the room left after the summary loads. Levels 3,
# 2z and 3pz produce the same bytes as 2 for this app.
project.optimization = 2
# Launcher icons are exact-size per device. Generated by
# scripts/generate-icons.ps1 - re-run it after changing the product list.
# The base resources directory deliberately declares no LauncherIcon, so
# there is exactly one definition per build and no duplicate resource id.
fr55.resourcePath = $(fr55.resourcePath);resources-launcher-35
fenix7.resourcePath = $(fenix7.resourcePath);resources-launcher-40
fenix7pro.resourcePath = $(fenix7pro.resourcePath);resources-launcher-40
fenix7s.resourcePath = $(fenix7s.resourcePath);resources-launcher-40
fenix7spro.resourcePath = $(fenix7spro.resourcePath);resources-launcher-40
