{
  // Type-checks the tests, which the build deliberately does not.
  //
  // tsconfig.json has rootDir "src" and excludes tests/, because the build emits
  // only the shipped code -- correct for a build, and it meant the one type
  // check CI ran never looked at a test file. A test asserting against a shape
  // the code no longer has still compiled, still ran, and still passed on
  // whatever it happened to assert; a stale fixture was invisible until someone
  // read it.
  //
  // Same strictness, no emit, tests and src together so cross-imports are
  // checked for real. Run by `npm run typecheck`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
